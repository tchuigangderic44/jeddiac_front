# ==============================================================================
# PLANETHOSTER / APACHE / LITESPEED CONFIGURATION FOR JEDDIAC.ORG
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Redirection automatique vers HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Routage SPA (Single Page Application - React / Vite)
    # Si le fichier ou dossier demandé n'existe pas physiquement, renvoyer index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [QSA,L]
</IfModule>

# ==============================================================================
# COMPRESSION GZIP / BROTLI (LITESPEED / APACHE)
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# ==============================================================================
# MISE EN CACHE DU NAVIGATEUR (CACHE-CONTROL & EXPIRES)
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML : Ne pas mettre en cache trop longtemps pour refléter les mises à jour
    ExpiresByType text/html "access plus 0 seconds"

    # Assets Vite avec hash (JS/CSS) : cache long
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType audio/wav "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
</IfModule>

# ==============================================================================
# SÉCURITÉ COMPLÉMENTAIRE
# ==============================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
